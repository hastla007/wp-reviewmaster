{
  "name": "hastla007/review-captain",
  "description": "Review Captain – Bewertungen und Social Proof für WordPress (Core).",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "brain/monkey": "^2.6"
  },
  "autoload-dev": {
    "psr-4": {
      "ReviewCaptain\\": "src/",
      "ReviewCaptain\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src tests examples review-captain.php uninstall.php -name '*.php' -print0 | xargs -0 -n1 php -l",
    "phpcs": "phpcs",
    "build": "bash bin/build-zip.sh"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
