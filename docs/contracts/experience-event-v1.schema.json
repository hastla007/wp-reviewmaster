{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://review-captain.example/contracts/experience-event-v1.schema.json",
  "title": "Review Captain experience event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "source", "event_id", "experience_id", "event_type", "occurred_at", "object"],
  "properties": {
    "contract": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "source": { "type": "string", "pattern": "^(connector:)?[a-z0-9-]{2,40}$" },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 191 },
    "experience_id": { "type": "string", "minLength": 1, "maxLength": 191 },
    "event_type": {
      "enum": ["experience_completed", "experience_cancelled", "experience_refunded", "experience_no_show", "recipient_opted_out"]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["product", "voucher_product", "event", "appointment", "course", "booking"] },
        "id": { "type": "string", "maxLength": 64 },
        "label": { "type": "string", "maxLength": 191 }
      }
    },
    "recipient_ref": { "type": "string", "maxLength": 191, "not": { "format": "email" } },
    "locale": { "type": "string", "pattern": "^[a-zA-Z]{2,3}([-_][a-zA-Z0-9]{2,8})*$" },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis"],
      "properties": {
        "basis": { "enum": ["consent", "existing_customer", "unknown", "denied"] },
        "recorded_at": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "maxLength": 40 },
        "text_version": { "type": "string", "maxLength": 40 }
      }
    },
    "verification": { "enum": ["purchase", "attendance"] },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "campaign_ref": { "type": "string", "maxLength": 64 },
        "order_item_ids": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "maxItems": 100 },
        "channel": { "type": "string", "maxLength": 40 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "experience_completed" } } },
      "then": { "required": ["recipient_ref", "communication"] }
    }
  ],
  "examples": [
    {
      "contract": "1.0",
      "source": "pass-captain",
      "event_id": "checkin-98765",
      "experience_id": "pass-captain:1:ticket:4711",
      "event_type": "experience_completed",
      "occurred_at": "2026-11-14T19:30:00Z",
      "object": { "type": "event", "id": "321", "label": "Herbstkonzert" },
      "recipient_ref": "pass-captain:attendee:5521",
      "locale": "de-AT",
      "communication": { "basis": "consent", "recorded_at": "2026-10-01T08:00:00Z", "source": "checkout", "text_version": "v2" },
      "verification": "attendance"
    }
  ]
}
