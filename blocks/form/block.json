{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "review-captain/form",
	"version": "1.0.0",
	"title": "Bewertungsformular (Review Captain)",
	"category": "widgets",
	"icon": "edit",
	"description": "Formular für Bewertungen von Besucherinnen und Besuchern – mit Moderation, Spam-Schutz und Einwilligung.",
	"keywords": [ "reviews", "bewertung", "formular" ],
	"textdomain": "review-captain",
	"supports": {
		"html": false,
		"multiple": true,
		"align": [ "wide" ],
		"spacing": { "margin": true }
	},
	"attributes": {
		"v": { "type": "string", "default": "1" },
		"contextType": { "type": "string", "default": "" },
		"contextId": { "type": "string", "default": "" }
	},
	"editorScript": "file:./editor.js"
}
