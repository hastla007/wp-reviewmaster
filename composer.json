{
	"name": "hastla007/review-captain",
	"description": "Review Captain – authentic reviews with clear source attribution for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0 || ^3.0 || ^4.0",
		"wp-phpunit/wp-phpunit": "^6.5",
		"johnpbloch/wordpress-core": "^6.5",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"test": "phpunit",
		"lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
		"phpcs": "phpcs",
		"build": "bash bin/build-zip.sh"
	}
}
