<?xml version="1.0"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	defaultTestSuite="review-captain"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
	>
	<testsuites>
		<testsuite name="review-captain">
			<directory suffix="Test.php">./tests/integration</directory>
		</testsuite>
		<testsuite name="perf">
			<directory suffix="Test.php">./tests/perf</directory>
		</testsuite>
	</testsuites>
</phpunit>
