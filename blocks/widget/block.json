{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "review-captain/widget",
	"title": "Review Captain Widget",
	"category": "widgets",
	"icon": "star-filled",
	"description": "Shows reviews with clear source attribution.",
	"keywords": [ "reviews", "testimonials", "rating" ],
	"textdomain": "review-captain",
	"attributes": {
		"widgetId": { "type": "integer", "default": 0 },
		"layout": { "type": "string", "default": "grid" },
		"providers": { "type": "array", "default": [], "items": { "type": "string" } },
		"limit": { "type": "integer", "default": 6 },
		"ratingMin": { "type": "integer", "default": 0 },
		"columns": { "type": "integer", "default": 0 },
		"testimonials": { "type": "boolean", "default": false },
		"contextType": { "type": "string", "default": "" },
		"contextId": { "type": "string", "default": "" }
	},
	"supports": { "html": false, "align": [ "wide", "full" ], "spacing": { "margin": true, "padding": true }, "color": { "background": true, "text": true } },
	"editorScript": "review-captain-blocks",
	"style": "review-captain"
}
