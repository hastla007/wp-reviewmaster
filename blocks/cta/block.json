{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "review-captain/cta",
	"title": "Review Captain Review Call to Action",
	"category": "widgets",
	"icon": "megaphone",
	"description": "Neutral buttons to your official review profiles.",
	"textdomain": "review-captain",
	"attributes": {
		"profiles": { "type": "array", "default": [], "items": { "type": "integer" } },
		"text": { "type": "string", "default": "" }
	},
	"supports": { "html": false, "spacing": { "margin": true, "padding": true } },
	"editorScript": "review-captain-blocks",
	"style": "review-captain"
}
