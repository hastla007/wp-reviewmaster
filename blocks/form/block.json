{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "review-captain/form",
	"title": "Review Captain Review Form",
	"category": "widgets",
	"icon": "edit",
	"description": "Lets visitors submit a review for moderation.",
	"textdomain": "review-captain",
	"attributes": {
		"contextType": { "type": "string", "default": "" },
		"contextId": { "type": "string", "default": "" },
		"reviewType": { "type": "string", "default": "general" }
	},
	"supports": { "html": false, "spacing": { "margin": true, "padding": true } },
	"editorScript": "review-captain-blocks",
	"style": "review-captain"
}
