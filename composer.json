{
	"name": "hastla007/review-captain",
	"description": "Review Captain – authentic reviews with clear source attribution for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"johnpbloch/wordpress-core": "^6.5",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.6",
		"wp-cli/i18n-command": "^2.7",
		"wp-cli/wp-cli": "^2.12",
		"wp-coding-standards/wpcs": "^3.1",
		"wp-phpunit/wp-phpunit": "^6.5",
		"yoast/phpunit-polyfills": "^2.0 || ^3.0 || ^4.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"test": "phpunit",
		"lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
		"phpcs": "phpcs",
		"build": "bash bin/build-zip.sh",
		"i18n": "wp i18n make-pot . languages/review-captain.pot --domain=review-captain --exclude=vendor,tests,docs,build,dist --skip-block-json"
	}
}
